# Panel del que salen los datos y los giros (sin barra final).
PANEL_URL=https://panel.supricom.com.ve
# Mismo valor que SORTEO_PROXY_SECRET en el panel (≥ 24 caracteres). Firma la
# IP real del visitante para que los límites del panel cuenten por visitante
# y no por la IP de este servidor.
SORTEO_PROXY_SECRET=
# Proxies propios delante de este servicio (EasyPanel/Traefik = 1).
PROXY_HOPS_CONFIABLES=1
